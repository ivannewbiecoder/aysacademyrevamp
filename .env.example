# Salin ke .env lalu isi nilainya. Jangan commit file .env.

# Koneksi PostgreSQL (wajib)
DATABASE_URL=postgres://ays:ganti_password@localhost:5432/ays

# URL publik situs, tanpa garis miring di akhir. Dipakai untuk canonical, sitemap, dan OG.
SITE_URL=https://aysacademy.id

# Garam untuk hash IP pengunjung (rate limit). Buat dengan: openssl rand -base64 32
IP_HASH_SALT=

# Jumlah reverse proxy di depan aplikasi (Nginx/Cloudflare/load balancer). 0 jika langsung.
TRUSTED_PROXY_COUNT=1

# Kunci enkripsi Server Actions; wajib sama di semua instance. Buat dengan: openssl rand -base64 32
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=

# Opsional: ID Google Analytics 4 (format G-XXXXXXX). Kosongkan untuk menonaktifkan.
NEXT_PUBLIC_GA_ID=

# Opsional: webhook HTTPS (Slack/Google Chat) yang diberi tahu setiap ada lead baru.
LEAD_WEBHOOK_URL=
